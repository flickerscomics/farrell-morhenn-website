// Calder Whitmore LLP — fictional GTA World roleplay law firm.
// Every record in this database describes in-character (fictional) people and matters.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Accounts, roles and sessions
// ─────────────────────────────────────────────────────────────

model Role {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String   @default("")
  permissions String[]
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

model User {
  id                 String        @id @default(cuid())
  email              String        @unique
  name               String
  passwordHash       String
  roleId             String
  role               Role          @relation(fields: [roleId], references: [id])
  isActive           Boolean       @default(true)
  mustChangePassword Boolean       @default(false)
  lastLoginAt        DateTime?
  staffProfileId     String?       @unique
  staffProfile       StaffProfile? @relation(fields: [staffProfileId], references: [id], onDelete: SetNull)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  sessions            Session[]
  resetTokens         PasswordResetToken[]
  assignedEnquiries   Enquiry[]            @relation("EnquiryAssignee")
  handledAppointments Appointment[]        @relation("AppointmentHandler")
  leadMatters         Matter[]             @relation("MatterLead")
  matterMemberships   MatterMember[]
  notes               Note[]
  matterEvents        MatterEvent[]
  messages            MatterMessage[]
  uploads             Upload[]
  auditEvents         AuditEvent[]

  @@index([roleId])
}

model ClientAccount {
  id            String    @id @default(cuid())
  email         String    @unique
  characterName String
  passwordHash  String
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions     Session[]
  resetTokens  PasswordResetToken[]
  enquiries    Enquiry[]
  appointments Appointment[]
  matters      Matter[]
  messages     MatterMessage[]
  uploads      Upload[]
}

enum SessionKind {
  STAFF
  CLIENT
}

model Session {
  id              String         @id @default(cuid())
  tokenHash       String         @unique
  kind            SessionKind
  userId          String?
  user            User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientAccountId String?
  clientAccount   ClientAccount? @relation(fields: [clientAccountId], references: [id], onDelete: Cascade)
  expiresAt       DateTime
  lastSeenAt      DateTime       @default(now())
  userAgent       String         @default("")
  createdAt       DateTime       @default(now())

  @@index([userId])
  @@index([clientAccountId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id              String         @id @default(cuid())
  tokenHash       String         @unique
  userId          String?
  user            User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientAccountId String?
  clientAccount   ClientAccount? @relation(fields: [clientAccountId], references: [id], onDelete: Cascade)
  expiresAt       DateTime
  usedAt          DateTime?
  createdAt       DateTime       @default(now())
}

// ─────────────────────────────────────────────────────────────
// Website configuration and content
// ─────────────────────────────────────────────────────────────

model SiteSettings {
  id                 Int      @id @default(1)
  firmName           String
  shortName          String
  tagline            String
  logoId             String?
  logo               Upload?  @relation("SettingsLogo", fields: [logoId], references: [id], onDelete: SetNull)
  colorPrimary       String   @default("#15233b")
  colorAccent        String   @default("#a8864f")
  phone              String
  email              String
  addressLines       String[]
  locationNote       String   @default("")
  officeHours        Json
  socialLinks        Json
  navigation         Json
  footerText         String   @default("")
  heroEyebrow        String   @default("")
  heroTitle          String
  heroText           String
  homeSections       Json
  contactMethods     String[]
  consultationTypes  String[]
  enquiryNotice      String   @default("")
  defaultAssigneeId  String?
  timezone           String   @default("America/Los_Angeles")
  slotMinutes        Int      @default(30)
  minNoticeHours     Int      @default(12)
  maxAdvanceDays     Int      @default(60)
  appointmentMinutes Int      @default(45)
  acceptingEnquiries Boolean  @default(true)
  acceptingBookings  Boolean  @default(true)
  updatedAt          DateTime @updatedAt
}

model Page {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  summary         String   @default("")
  body            String   @default("")
  sections        Json     @default("[]")
  metaDescription String   @default("")
  isPublished     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Milestone {
  id          String   @id @default(cuid())
  year        String
  title       String
  description String   @default("")
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum StaffRole {
  MANAGING_PARTNER
  PARTNER
  SENIOR_ATTORNEY
  ASSOCIATE_ATTORNEY
  PARALEGAL
  LEGAL_CLERK
  INVESTIGATOR
  OFFICE_MANAGER
  RECEPTIONIST
  ADMINISTRATIVE
}

enum StaffStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
  DEPARTED
}

model StaffProfile {
  id                   String      @id @default(cuid())
  slug                 String      @unique
  fullName             String
  title                String
  role                 StaffRole
  portraitId           String?
  portrait             Upload?     @relation("StaffPortrait", fields: [portraitId], references: [id], onDelete: SetNull)
  shortBio             String      @default("")
  biography            String      @default("")
  background           String      @default("")
  qualifications       String      @default("")
  barAdmissions        String      @default("")
  languages            String[]
  notableCases         String      @default("")
  achievements         String      @default("")
  email                String      @default("")
  phone                String      @default("")
  acceptsConsultations Boolean     @default(false)
  isLeadership         Boolean     @default(false)
  isFeatured           Boolean     @default(false)
  isPublished          Boolean     @default(true)
  status               StaffStatus @default(ACTIVE)
  sortOrder            Int         @default(0)
  joinedYear           Int?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  practiceAreas      PracticeArea[]
  user               User?
  articles           Article[]
  preferredEnquiries Enquiry[]      @relation("EnquiryPreferredAttorney")
  appointments       Appointment[]

  @@index([status, isPublished])
}

model PracticeArea {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  shortDescription String
  overview         String   @default("")
  matterTypes      String[]
  services         String[]
  intakeFields     Json     @default("[]")
  isPublished      Boolean  @default(true)
  isFeatured       Boolean  @default(false)
  sortOrder        Int      @default(0)
  metaDescription  String   @default("")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  attorneys StaffProfile[]
  faqs      Faq[]
  articles  Article[]
  enquiries Enquiry[]
  matters   Matter[]

  @@index([isPublished, sortOrder])
}

model ArticleCategory {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String    @default("")
  sortOrder   Int       @default(0)
  articles    Article[]
}

enum ArticleType {
  ANNOUNCEMENT
  LEGAL_ARTICLE
  RECRUITMENT
  COMMUNITY
  CASE_ANNOUNCEMENT
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Article {
  id              String           @id @default(cuid())
  slug            String           @unique
  title           String
  summary         String
  body            String
  type            ArticleType      @default(LEGAL_ARTICLE)
  categoryId      String?
  category        ArticleCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags            String[]
  authorId        String?
  author          StaffProfile?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  featuredImageId String?
  featuredImage   Upload?          @relation("ArticleImage", fields: [featuredImageId], references: [id], onDelete: SetNull)
  status          PublishStatus    @default(DRAFT)
  publishedAt     DateTime?
  isFeatured      Boolean          @default(false)
  metaDescription String           @default("")
  // Internal link only — never selected by public queries.
  sourceMatterId  String?
  sourceMatter    Matter?          @relation(fields: [sourceMatterId], references: [id], onDelete: SetNull)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  practiceAreas PracticeArea[]

  @@index([status, publishedAt])
  @@index([type])
}

model FaqCategory {
  id        String @id @default(cuid())
  slug      String @unique
  name      String
  sortOrder Int    @default(0)
  faqs      Faq[]
}

model Faq {
  id             String        @id @default(cuid())
  question       String
  answer         String
  categoryId     String?
  category       FaqCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  practiceAreaId String?
  practiceArea   PracticeArea? @relation(fields: [practiceAreaId], references: [id], onDelete: SetNull)
  sortOrder      Int           @default(0)
  isPublished    Boolean       @default(true)
  archivedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([categoryId, sortOrder])
}

// ─────────────────────────────────────────────────────────────
// Intake, scheduling and matters
// ─────────────────────────────────────────────────────────────

enum EnquiryStatus {
  NEW
  UNDER_REVIEW
  AWAITING_INFORMATION
  AWAITING_CLIENT_RESPONSE
  CONSULTATION_REQUESTED
  ACCEPTED
  DECLINED
  CLOSED
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Enquiry {
  id                  String         @id @default(cuid())
  reference           String         @unique
  characterName       String
  contactDetails      String         @default("")
  preferredContact    String         @default("")
  practiceAreaId      String?
  practiceArea        PracticeArea?  @relation(fields: [practiceAreaId], references: [id], onDelete: SetNull)
  subject             String
  description         String
  preferredAttorneyId String?
  preferredAttorney   StaffProfile?  @relation("EnquiryPreferredAttorney", fields: [preferredAttorneyId], references: [id], onDelete: SetNull)
  preferredDate       String         @default("")
  preferredTime       String         @default("")
  intakeData          Json           @default("[]")
  status              EnquiryStatus  @default(NEW)
  priority            Priority       @default(NORMAL)
  assignedToId        String?
  assignedTo          User?          @relation("EnquiryAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  followUpAt          DateTime?
  matterId            String?
  matter              Matter?        @relation(fields: [matterId], references: [id], onDelete: SetNull)
  clientAccountId     String?
  clientAccount       ClientAccount? @relation(fields: [clientAccountId], references: [id], onDelete: SetNull)
  idempotencyKey      String?        @unique
  contentHash         String
  sourceIpHash        String         @default("")
  closedAt            DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  appointments Appointment[]
  notes        Note[]
  attachments  Upload[]

  @@index([status, createdAt])
  @@index([assignedToId])
  @@index([contentHash, createdAt])
  @@index([followUpAt])
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  RESCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
  DECLINED
}

model Appointment {
  id               String            @id @default(cuid())
  reference        String            @unique
  characterName    String
  contactDetails   String            @default("")
  preferredContact String            @default("")
  attorneyId       String?
  attorney         StaffProfile?     @relation(fields: [attorneyId], references: [id], onDelete: SetNull)
  consultationType String
  requestedStart   DateTime
  alternativeStart DateTime?
  scheduledStart   DateTime?
  durationMinutes  Int               @default(45)
  reason           String
  notes            String            @default("")
  location         String            @default("")
  status           AppointmentStatus @default(REQUESTED)
  statusReason     String            @default("")
  enquiryId        String?
  enquiry          Enquiry?          @relation(fields: [enquiryId], references: [id], onDelete: SetNull)
  matterId         String?
  matter           Matter?           @relation(fields: [matterId], references: [id], onDelete: SetNull)
  handledById      String?
  handledBy        User?             @relation("AppointmentHandler", fields: [handledById], references: [id], onDelete: SetNull)
  clientAccountId  String?
  clientAccount    ClientAccount?    @relation(fields: [clientAccountId], references: [id], onDelete: SetNull)
  idempotencyKey   String?           @unique
  contentHash      String
  sourceIpHash     String            @default("")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  internalNotes Note[]

  @@index([status, requestedStart])
  @@index([scheduledStart])
  @@index([contentHash, createdAt])
}

enum MatterStatus {
  INTAKE
  CONFLICT_CHECK_PENDING
  AWAITING_ENGAGEMENT
  ACTIVE
  AWAITING_CLIENT
  AWAITING_HEARING
  ON_HOLD
  CONCLUDED
  ARCHIVED
}

model Matter {
  id              String         @id @default(cuid())
  reference       String         @unique
  title           String
  clientName      String
  clientContact   String         @default("")
  clientAccountId String?
  clientAccount   ClientAccount? @relation(fields: [clientAccountId], references: [id], onDelete: SetNull)
  practiceAreaId  String?
  practiceArea    PracticeArea?  @relation(fields: [practiceAreaId], references: [id], onDelete: SetNull)
  leadAttorneyId  String?
  leadAttorney    User?          @relation("MatterLead", fields: [leadAttorneyId], references: [id], onDelete: SetNull)
  description     String         @default("")
  status          MatterStatus   @default(INTAKE)
  priority        Priority       @default(NORMAL)
  isRestricted    Boolean        @default(false)
  openedAt        DateTime       @default(now())
  closedAt        DateTime?
  followUpAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  members      MatterMember[]
  enquiries    Enquiry[]
  appointments Appointment[]
  events       MatterEvent[]
  notes        Note[]
  documents    Upload[]
  messages     MatterMessage[]
  publicPosts  Article[]

  @@index([status])
  @@index([leadAttorneyId])
  @@index([clientAccountId])
  @@index([followUpAt])
}

model MatterMember {
  matterId  String
  matter    Matter   @relation(fields: [matterId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("Support")
  createdAt DateTime @default(now())

  @@id([matterId, userId])
  @@index([userId])
}

enum MatterEventType {
  UPDATE
  HEARING
  DEADLINE
  FILING
  MEETING
  MILESTONE
}

model MatterEvent {
  id            String          @id @default(cuid())
  matterId      String
  matter        Matter          @relation(fields: [matterId], references: [id], onDelete: Cascade)
  type          MatterEventType @default(UPDATE)
  title         String
  body          String          @default("")
  occursAt      DateTime
  isDeadline    Boolean         @default(false)
  completedAt   DateTime?
  clientVisible Boolean         @default(false)
  authorId      String?
  author        User?           @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([matterId, occursAt])
  @@index([isDeadline, completedAt, occursAt])
}

model MatterMessage {
  id             String         @id @default(cuid())
  matterId       String
  matter         Matter         @relation(fields: [matterId], references: [id], onDelete: Cascade)
  body           String
  senderUserId   String?
  senderUser     User?          @relation(fields: [senderUserId], references: [id], onDelete: SetNull)
  senderClientId String?
  senderClient   ClientAccount? @relation(fields: [senderClientId], references: [id], onDelete: SetNull)
  readByStaffAt  DateTime?
  readByClientAt DateTime?
  createdAt      DateTime       @default(now())

  @@index([matterId, createdAt])
}

// Private internal notes. Never exposed to public visitors or portal clients.
model Note {
  id            String       @id @default(cuid())
  body          String
  authorId      String?
  author        User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  enquiryId     String?
  enquiry       Enquiry?     @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  matterId      String?
  matter        Matter?      @relation(fields: [matterId], references: [id], onDelete: Cascade)
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())

  @@index([enquiryId])
  @@index([matterId])
  @@index([appointmentId])
  @@index([applicationId])
}

// ─────────────────────────────────────────────────────────────
// Recruitment
// ─────────────────────────────────────────────────────────────

enum VacancyStatus {
  DRAFT
  OPEN
  CLOSED
}

model Vacancy {
  id               String        @id @default(cuid())
  slug             String        @unique
  title            String
  department       String        @default("")
  employmentType   String        @default("")
  summary          String
  description      String        @default("")
  responsibilities String[]
  requirements     String[]
  status           VacancyStatus @default(DRAFT)
  publishedAt      DateTime?
  closesAt         DateTime?
  sortOrder        Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  applications Application[]
}

enum ApplicationStatus {
  RECEIVED
  UNDER_REVIEW
  INTERVIEW
  OFFERED
  HIRED
  UNSUCCESSFUL
  WITHDRAWN
}

model Application {
  id               String            @id @default(cuid())
  reference        String            @unique
  vacancyId        String?
  vacancy          Vacancy?          @relation(fields: [vacancyId], references: [id], onDelete: SetNull)
  desiredRole      String
  characterName    String
  contactDetails   String            @default("")
  preferredContact String            @default("")
  experience       String
  availability     String
  statement        String
  status           ApplicationStatus @default(RECEIVED)
  decision         String            @default("")
  decidedAt        DateTime?
  archivedAt       DateTime?
  idempotencyKey   String?           @unique
  contentHash      String
  sourceIpHash     String            @default("")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  notes       Note[]
  attachments Upload[]

  @@index([status, createdAt])
  @@index([vacancyId])
  @@index([contentHash, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Files, audit and abuse controls
// ─────────────────────────────────────────────────────────────

enum UploadVisibility {
  PUBLIC
  PRIVATE
}

enum UploadPurpose {
  PORTRAIT
  LOGO
  ARTICLE_IMAGE
  GENERAL_IMAGE
  ENQUIRY_ATTACHMENT
  APPLICATION_ATTACHMENT
  MATTER_DOCUMENT
  CLIENT_UPLOAD
}

model Upload {
  id                 String           @id @default(cuid())
  storageKey         String           @unique
  originalName       String
  mimeType           String
  size               Int
  width              Int?
  height             Int?
  visibility         UploadVisibility
  purpose            UploadPurpose
  altText            String           @default("")
  clientVisible      Boolean          @default(false)
  uploadedById       String?
  uploadedBy         User?            @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedByClientId String?
  uploadedByClient   ClientAccount?   @relation(fields: [uploadedByClientId], references: [id], onDelete: SetNull)
  enquiryId          String?
  enquiry            Enquiry?         @relation(fields: [enquiryId], references: [id], onDelete: SetNull)
  applicationId      String?
  application        Application?     @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  matterId           String?
  matter             Matter?          @relation(fields: [matterId], references: [id], onDelete: SetNull)
  createdAt          DateTime         @default(now())

  settingsLogo  SiteSettings[] @relation("SettingsLogo")
  portraitFor   StaffProfile[] @relation("StaffPortrait")
  articleImages Article[]      @relation("ArticleImage")

  @@index([visibility, purpose])
  @@index([matterId])
  @@index([enquiryId])
  @@index([applicationId])
}

enum ActorType {
  STAFF
  CLIENT
  PUBLIC
  SYSTEM
}

model AuditEvent {
  id         String    @id @default(cuid())
  actorType  ActorType
  actorId    String?
  actor      User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorLabel String    @default("")
  action     String
  entityType String
  entityId   String?
  summary    String
  metadata   Json      @default("{}")
  createdAt  DateTime  @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([createdAt])
  @@index([actorId])
}

model RateLimitHit {
  id        String   @id @default(cuid())
  bucket    String
  keyHash   String
  createdAt DateTime @default(now())

  @@index([bucket, keyHash, createdAt])
}

model ReferenceCounter {
  key   String @id
  value Int    @default(0)
}

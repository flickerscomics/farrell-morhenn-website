# Copy this file to .env and replace every placeholder. Never commit .env.

# PostgreSQL connection string for the application database.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/lawfirm?schema=public"

# Separate database used by the automated test suite. It is wiped by the tests.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/lawfirm_test?schema=public"

# Long random string used to sign form tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET="replace-with-a-long-random-string"

# Public base URL of the site (used for canonical URLs, sitemap and social metadata).
SITE_URL="http://localhost:3000"

# Directory where uploaded files are stored. Must be outside the public web root.
STORAGE_DIR="./storage"

# Maximum upload size in megabytes (images and documents).
MAX_UPLOAD_MB="8"

# Set to "true" only when serving over plain HTTP in production behind a trusted proxy
# that terminates TLS. Leave unset in normal deployments.
# INSECURE_COOKIES="false"

# Separate database for the Playwright end-to-end tests. It is reset by each run.
E2E_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/lawfirm_e2e?schema=public"
